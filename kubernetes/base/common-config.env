# postgres
POSTGRES_USER=dbuser

# rabbit
RABBITMQ_HOST=rabbitmq-service
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rmuser

# minio
MINIO_ENDPOINT=minio-service:9000
MINIO_BUCKET=bulletins

# eureka
EUREKA_PATH=http://eureka-service:8761/eureka/

# Keycloak URLs 
KEYCLOAK_TOKEN_URI=http://keycloak-service:8080/realms/oAuth/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URI=http://localhost/auth/realms/oAuth/protocol/openid-connect/logout
KEYCLOAK_CLIENT_ID=myclient
KEYCLOAK_ISSUER_URI=http://localhost/auth/realms/oAuth

# Управление и мониторинг
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_SECURITY_ENABLED=false

# SMTP (общие для всех сервисов)
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_PROTOCOL=smtps
MAIL_USERNAME=Pavel200-7@yandex.ru